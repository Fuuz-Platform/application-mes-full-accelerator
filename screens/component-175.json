              "AFDfBXUpi": {
                "type": {
                  "resolvedName": "Scheduler"
                },
                "isCanvas": false,
                "props": {
                  "query": {
                    "api": "Application",
                    "query": "query Scheduler($workcenterWhere:WorkcenterWhereInput, $distributionWhere:WorkOrderProcessDistributionWhereInput) {\n  workcenter(where: $workcenterWhere) {\n    edges {\n      node {\n        id\n        name\n        productionSetup {\n          mode {\n            name\n            modeType {\n              production\n              maintenance\n              changeover\n              idle\n              color\n            }\n          }\n        }\n        workcenterGroup {\n          name\n        }\n        shiftGroup {\n          id\n          name\n          shifts {\n            edges { \n              node {  \n                shift {\n                  name\n                  startAt\n                  endAt\n                  sunday\n                  monday\n                  tuesday\n                  wednesday\n                  thursday\n                  friday\n                  saturday\n                }\n              }\n            }\n          }\n        }\n        image {\n          thumbnailUrl\n        }\n      }\n    }\n  }\n  \n  workOrderProcessDistribution(where: $distributionWhere) {\n    edges {\n      node {\n        id\n        number\n      \tleadingDistributionId\n        resourceId: workcenterId\n        startDate: scheduledStartAt\n        endDate: scheduledFinishAt\n        requiredQuantity\n        workOrderProcessDistributionStatus {\n          name\n          color\n        }\n        workOrderProcess {\n          order\n          process {\n\t\t\t\t\t\tcode\n          }\n          workOrder {\n            number\n            quantity\n            workOrderPriority {\n              color\n              name\n            }\n          }\n          productStrategyProcess {\n            code\n          }\n          productStrategy {\n            product {\n              number\n            }\n          }\n        }\n      }\n    }\n  }\n}",
                    "dataPath": null,
                    "dataTransform": {
                      "transform": null,
                      "remote": true
                    },
                    "dataSubscription": {
                      "enabled": false
                    },
                    "autoLoad": true,
                    "fields": [
                      "id"
                    ],
                    "parameters": "(\n  $variables := $components.Form1.fn.getVariables(true);\n  $mergeDeep([$variables, {\n  \"distributionWhere\": {\n    \"scheduledStartAt\": {\n      \"_gt\": $moment().subtract(14, 'd')\n    }\n  }\n  }])\n)"
                  },
                  "blockNavigationWhenDirty": true,
                  "scheduler": {
                    "config": {
                      "groupFeature": {
                        "field": "workcenterGroup.name"
                      }
                    },
                    "events": {
                      "__transform": "[data.workOrderProcessDistribution.edges.node\n  ~> | $ | {\n    \"name\": workOrderProcess.productStrategy.product.number & \" - Qty \" & requiredQuantity,\n    \"eventColor\": $coalesce([\n      workOrderProcessDistributionStatus.color,\n      \"light-gray\"\n    ]),\n    \"tooltipHtml\": '<b>Work Order:</b> ' & workOrderProcess.workOrder.number & '<br />'\n      & '&nbsp;&nbsp;' & workOrderProcess.workOrder.quantity & ' of <i>' & workOrderProcess.productStrategy.product.number & '</i> due by ' & $moment(workOrderProcess.workOrder.promiseAt).format('L') & '<br />'\n      & '&nbsp;&nbsp;<b>Priority: </b>' & \"<i style='color:\" & workOrderProcess.workOrder.workOrderPriority.color & \"' class='b-fa-solid b-fa-circle'></i> \" & workOrderProcess.workOrder.workOrderPriority.name & '<br />'\n      & '<b>Process:</b> ' & workOrderProcess.order & ' (' & workOrderProcess.process.code & ') <br />'\n      & '&nbsp;&nbsp;<b>Status: </b>' & \"<i style='color:\" & workOrderProcessDistributionStatus.color & \"' class='b-fa-solid b-fa-circle'></i> \" & workOrderProcessDistributionStatus.name & '<br />'\n      & '&nbsp;&nbsp;<b>Scheduled: </b>' & (\n        startDate ? $moment(startDate).format('L LT') : '?'\n      ) & ' - ' & (\n        endDate ? $moment(endDate).format('L LT') : '?'\n      ) & '<br />',\n    \"eventHtml\": '<div>' \n      & workOrderProcess.productStrategy.product.number\n      & '<br />' \n      & 'Qty ' & requiredQuantity\n      & '</div>'\n  } |]",
                      "__dynamicFields": {
                        "payload": [
                          "data.workOrderProcessDistribution"
                        ],
                        "context": []
                      },
                      "__cacheKey": "events",
                      "__remote": false,
                      "__fallbackValue": []
                    },
                    "resources": {
                      "__transform": "(\n  [data.workcenter.edges.node\n    ~> | $ | {\n      \"imageUrl\": image.thumbnailUrl,\n      \"workcenterGroup\": $coalesce([workcenterGroup, {\n        \"name\": \"(No Group)\"\n      }]),\n      \"calendar\": shiftGroup.id,\n      \"metaHtml\": $isNilOrEmpty(productionSetup.mode) \n        ? null\n        : (\n          $modeType := productionSetup.mode.modeType;\n\n          $icon := $modeType.production\n            ? 'circle-check'\n            : $modeType.maintenance\n            ? 'wrench'\n            : $modeType.changeover\n            ? 'exchange'\n            : $modeType.idle\n            ? 'ellipsis-h'\n            : '';\n\n          \"<i style='color:\" & $modeType.color & \"' class='b-fa-solid b-fa-\" & $icon & \"'></i>&nbsp;&nbsp;\" & productionSetup.mode.name\n        )\n  } |][\n    $components.Form1.data.scheduledWorkcentersOnly ? (\n      $eventsByWorkcenter := $groupBy($$.data.workOrderProcessDistribution.edges.node, function($v) { $v.resourceId });\n      \n      $isNotNilOrEmpty($lookup($eventsByWorkcenter, $.id))\n    ) : true\n  ]\n\n)",
                      "__dynamicFields": {
                        "payload": [
                          "data.workcenter"
                        ],
                        "context": [
                          "components.Form1.data.scheduledWorkcentersOnly"
                        ]
                      },
                      "__cacheKey": "resources",
                      "__remote": false,
                      "__fallbackValue": []
                    },
                    "calendars": {
                      "__transform": "(\n  $convertDate := function($date) {\n    $moment($date).tz(\"UTC\").tz($momentTzGuess(), true)\n  };\n\n  $formatTime := function($date) {\n    $moment($date).tz(\"UTC\").tz($momentTzGuess(), true).format('HH:mm')\n  };\n  \n  $formatDays := function($shift, $overnight) {\n    $join([\n      ($shift.sunday ? ($overnight ? 'monday' : 'sunday')),\n      ($shift.monday ? ($overnight ? 'tuesday' : 'monday')),\n      ($shift.tuesday ? ($overnight ? 'wednesday' : 'tuesday')),\n      ($shift.wednesday ? ($overnight ? 'thursday' : 'wednesday')),\n      ($shift.thursday ? ($overnight ? 'friday' : 'thursday')),\n      ($shift.friday ? ($overnight ? 'saturday' : 'friday')),\n      ($shift.saturday ? ($overnight ? 'sunday' : 'saturday'))\n    ][$isNotNilOrEmpty($)], ',')\n  };\n\n  [\n    $uniqBy(\n      [data.workcenter.edges.node.shiftGroup],\n      function($v) { $v.id }\n    ).{\n      \"id\": id,\n      \"name\": name,\n      \"unspecifiedTimeIsWorking\": false,\n      \"intervals\": [shifts.edges.node.shift[\n        $isNotNilOrEmpty(startAt)\n          and $isNotNilOrEmpty(endAt)\n      ].(\n        $startAt := $convertDate(startAt);\n        $endAt := $convertDate(endAt);\n        \n        {\n          \"name\": name,\n          \"recurrentStartDate\": \"at \" & $startAt.format('HH:mm') & \" on \" & $formatDays($, false),\n          \"recurrentEndDate\": \"at \"& $endAt.format('HH:mm') & \" on \" & $formatDays($, $moment($endAt).isBefore($startAt)),\n          \"isWorking\": true\n        }\n      )]\n    }\n  ]\n)",
                      "__dynamicFields": {
                        "payload": [
                          "data.workcenter"
                        ],
                        "context": []
                      },
                      "__cacheKey": "calendars",
                      "__remote": false,
                      "__fallbackValue": []
                    },
                    "dependencies": {
                      "__transform": "[\n  data.workOrderProcessDistribution.edges.node[\n    $isNotNilOrEmpty(leadingDistributionId)\n  ].{\n    \"id\": leadingDistributionId & \"~\" & id,\n    \"from\": leadingDistributionId,\n    \"to\": id\n  }\n]",
                      "__dynamicFields": {
                        "payload": [
                          "data.workOrderProcessDistribution"
                        ],
                        "context": []
                      },
                      "__cacheKey": "dependencies",
                      "__remote": false,
                      "__fallbackValue": []
                    },
                    "assignments": [],
                    "includeUnassignedResource": true,
                    "includeResourceInfoColumn": true,
                    "includeUtilizationColumn": true,
                    "additionalColumns": [],
                    "unassignedResource": {
