              "wuRn804Or": {
                "type": {
                  "resolvedName": "ActionButton"
                },
                "isCanvas": false,
                "props": {
                  "margin": 6,
                  "buttonColor": "primary",
                  "icon": {
                    "icon": "split",
                    "color": "inherit",
                    "variant": "duotone",
                    "size": "icon"
                  },
                  "width": "76px",
                  "height": "48px",
                  "disabled": false,
                  "hidden": false,
                  "useIconButton": false,
                  "disableHover": false,
                  "disableRipple": false,
                  "action": [
                    {
                      "type": "mutation",
                      "api": "Application",
                      "mutation": "mutation (\n  $distributionCreatePayload: [WorkOrderProcessDistributionCreatePayloadInput!]!,\n  $distributionUpdatePayload: [WorkOrderProcessDistributionUpdatePayloadInput!]!,\n  $distributionGroupCreatePayload: [WorkOrderProcessDistributionGroupCreatePayloadInput!]!\n  $distributionGroupUpdatePayload: [WorkOrderProcessDistributionGroupUpdatePayloadInput!]!\n){\n  createWorkOrderProcessDistributionGroup(payload: $distributionGroupCreatePayload){ id }\n  updateWorkOrderProcessDistributionGroup(payload: $distributionGroupUpdatePayload){ id }\n  createWorkOrderProcessDistribution(payload: $distributionCreatePayload){ id }\n  updateWorkOrderProcessDistribution(payload: $distributionUpdatePayload){ id }\n}",
                      "transforms": {
                        "pre": "(\n  \n  $distributionGroupId := $cuid();\n  $distributionChanges := [($components.Cards1.data~>| $ | {\"splitQuantity\": $number(splitQuantity)} |)\n  [splitQuantity > 0 ]].\n  (\n  \n     splitQuantity > balanceQuantity?\n      $throw(\"Quantity to split \" & splitQuantity & \" is larger then the balance of the distribution \" & balanceQuantity);\n      \n    $update := $.(\n      $balanceQuantity := balanceQuantity - splitQuantity;\n      $requiredQuantity := requiredQuantity - splitQuantity;\n      {\n        \"where\":{ \"id\": id},\n        \"update\": {\n          \"percentComplete\": producedQuantity / $requiredQuantity,\n          \"balanceQuantity\": $balanceQuantity,\n          \"requiredQuantity\": $requiredQuantity,\n          \"estimatedTime\": ($requiredQuantity / standardRate) * 3600000 + setupRate\n        }\n      }\n      \n    );\n\n    $create := $~>|$|\n      {\n        \"percentComplete\": 0,\n        \"balanceQuantity\": splitQuantity,\n        \"requiredQuantity\": splitQuantity,\n        \"estimatedTime\": (splitQuantity / standardRate) * 3600000 + setupRate,\n        \"distributionGroupId\": $distributionGroupId\n      }, [\"splitQuantity\", \"workOrder\", \"workOrderProcess\", \"id\"]|;\n    \n    { \"create\": $create, \"update\": $update}\n  );\n\n  \n  $distributionGroupCreatePayload := $metadata.urlParameters.group~>| $ | {\n    \"id\": $distributionGroupId,\n    \"balanceQuantity\": $sum($distributionChanges.create.requiredQuantity),\n    \"estimatedTime\": $sum($distributionChanges.create.estimatedTime),\n    \"percentComplete\": 0,\n    \"producedQuantity\": 0,\n    \"requiredQuantity\": $sum($distributionChanges.create.requiredQuantity),\n    \"scrappedQuantity\": 0,\n    \"workOrderProcessDistributionStatusId\": \"New\",\n    \"customData\":{\n      \"note\": $components.Form1.note\n    }\n  }, [\n    \"newSequence\", \n    \"data.duration\", \n    \"expFin\", \n    \"data.workOrder\", \n    \"expCompletion\", \n    \"woPriority\", \n    \"process\",\n    \"product\",\n    \"workOrder\",\n    \"woType\",\n    \"woDue\",\n    \"distributions\",\n    \"workOrderProcessDistributionStatus\",\n    \"duration\"\n    ]|;\n \n      \n  $alldistributions := [$distributionChanges.update.update, $components.Cards1.data[splitQuantity = 0 ]];\n  $newRequiredQuantity := $sum([$alldistributions.requiredQuantity]);\n  $newBalanceQuantity := $sum([$alldistributions.balanceQuantity]);\n  $totalProducedQuantity := $sum([$components.Cards1.data.producedQuantity]);\n  $distributionGroupUpdatePayload := {\n     \"where\":{ \"id\": $first($components.Cards1.data.distributionGroupId)},\n     \"update\":{\n       \"percentComplete\": $totalProducedQuantity / $newRequiredQuantity,\n       \"balanceQuantity\": $newBalanceQuantity,\n       \"requiredQuantity\": $newRequiredQuantity,\n       \"estimatedTime\": $sum($alldistributions.estimatedTime) \n     }\n  };\n\n  {\n    \"distributionCreatePayload\":[ $distributionChanges.create.{\"create\": $}],\n    \"distributionUpdatePayload\":[ $distributionChanges.update],\n    \"distributionGroupCreatePayload\": [{\"create\": $distributionGroupCreatePayload}],\n    \"distributionGroupUpdatePayload\": [$distributionGroupUpdatePayload]\n  } \n\n)",
                        "post": "$components.Screen.fn.return()\n\n"
                      },
                      "message": "Distribution Group Split"
                    }
                  ]
                },
