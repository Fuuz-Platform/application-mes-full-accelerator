                      "remote": false
                    },
                    "autoLoad": false,
                    "parameters": "$merge([\n  {\n    \"orderBy\": {\n      \"field\": \"occurredAt\",\n      \"direction\": \"desc\"\n    },\n    \"first\": 5000,\n    \"filter\": {\n      \"iotTagTypeId\": {\n        \"_eq\": \"Process\"\n      }\n    }\n  },\n  $components.Filter.fn.getVariables(true)\n])",
