          "name": "Prepare Payload",
          "type": "transform",
          "data": {
            "transform": "(\n\n  $values := shipperLineFulfillmentStep.edges.node.(\n    type = \"container\"?  inventory : masterUnit.masterUnitInventories.edges.node\n  );\n  \n  {\n    \"jobIds\": [$uniq($values.jobId).($?$)],\n    \"itemIds\": [$uniq($values.itemId)],\n    \"masterUnitIds\": [$uniq($values.masterUnitId)] ,\n    \"shiptoId\": shipper.edges.node.customerShipToId\n  }\n\n)",
