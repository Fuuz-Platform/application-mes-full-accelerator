          "name": "Query jobs, masters, and items",
          "type": "query",
          "data": {
            "api": "application",
            "variablesTransform": "$",
            "query": "query ($shipperId: String!){\n  shipperLineFulfillmentStep(where:{\n    shipperLineFulfillment:{\n      shipmentLine:{\n        shipmentId:{_eq: $shipperId}\n      }\n    }\n  }){\n    edges{\n      node{\n        id\n        type\n        inventory{\n          number\n          productStrategyProcessId\n          workOrderId\n          masterInventoryId\n        }\n        masterInventory {\n          id\n          inventory{\n            edges{\n              node{\n                number\n                productStrategyProcessId\n                workOrderId\n                masterInventoryId\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n  \n  shipment(where:{\n      id:{_eq: $shipperId}\n  }){\n    edges{\n      node{\n        shipToCustomerAddressId\n      }\n    }\n  }\n}",
            "nextNodes": [
              "13b4cbb8-4dfc-493f-b39b-94e6744e7544"
            ]
          },
          "debug": {
