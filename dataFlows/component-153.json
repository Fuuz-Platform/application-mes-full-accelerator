        {
          "id": "637a9d54-b543-4003-bb2a-6a60c4543238",
          "name": "Mutate Create Receipt/Receipt Lines",
          "type": "mutate",
          "data": {
            "api": "Application",
            "variablesTransform": "{\n  \"payload\": [$.receiptPayload],\n  \"payloadReceiptLine\": [$.receiptLinePayload]\n}",
            "mutation": "mutation Mutation($payload: [ReceiptCreatePayloadInput!]!,$payloadReceiptLine: [ReceiptLineCreatePayloadInput!]!) {\n  createReceipt(payload: $payload) {\n    id\n    number\n    externalId\n    note\n    shipper\n    receiptAt\n    customData\n    integrationData\n    statusId\n    locationId\n    purchaseOrderId\n    transferOrderId\n  }\n  createReceiptLine(payload: $payloadReceiptLine) {\n    id\n    number\n    licensePlates\n    supplierLabel\n    externalId\n    lotNumber\n    note\n    customData\n    integrationData\n    receiptId\n    statusId\n    lotId\n    purchaseOrderLineId\n    purchaseOrderLineReleaseId\n    transferOrderLineId\n    workOrderProcessDistributionGroupId\n  }\n}\n",
            "nextNodes": [
              "b5c0f87f-c3cd-49d3-84ba-6f069a3e22fd"
            ]
          },
          "debug": {
            "breakpointEnabled": true,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
          "logging": {
            "executionMetrics": false,
            "executionStarted": false,
            "executionSucceeded": false,
            "executionFailed": true,
            "enableTraceLogging": false
          }
        },
        {
          "id": "4878b07b-6dfd-4cf6-b061-46cd6f7dd2aa",
          "name": "Format Receipt and ReceiptLine",
          "type": "transform",
          "data": {
            "transform": "(\n$quantityReceived:=$state.context.receiptData.goodQty;\n$unitsReceived:=$state.context.receiptData.unitsReceived;\n$scrapQuantity:=$state.context.receiptData.scrapQty;\n$unitId:=$state.context.woForm.workOrder.productStrategy.inventoryUnitId;\n$groupId:=$state.context.woForm.workOrderProcessDistributions.edges.node.distributionGroupId;\n$receiptId:=$cuid();\n   \n$formatPayloads:={\n  \"receipt\":{\n\t\t\"create\": {\n\t\t\t\"id\": $receiptId,\n\t\t\t\"note\": $state.context.receiptData.note,\n\t\t\t\"shipper\": $state.context.receiptData.shipper, \n\t\t\t\"statusId\": \"Pending\",\n\t\t\t\"locationId\": $state.context.receiptData.location.id \n\t\t}\n\t},\n  \"unitsReceived\": $map([1.. $unitsReceived], function($v, $i, $a) {\n  {\n\t\t\"create\": {\n\t\t\t\"licensePlates\": 1,\n\t\t\t\"supplierLabel\": false,\n\t\t\t\"lotNumber\": $state.context.receiptData.lotNumber,\n\t\t\t\"note\": $state.context.receiptData.note,\n\t\t\t\"quantity\": { \"value\": $quantityReceived, \"unitId\": $unitId },\n\t\t\t\"quantityPerLicensePlate\": { \"value\": $quantityReceived, \"unitId\": $unitId },\n\t\t\t\"receiptId\": $receiptId,\n\t\t\t\"statusId\": \"Pending\",\n\t\t\t\"workOrderProcessDistributionGroupId\": $groupId\n\t\t}\n\t}\n  }),\n  \"scrap\": ($scrapQuantity?{\"create\":{\n      \"customData\":{\"scrap\":true},\n\t\t\t\"licensePlates\": 1,\n\t\t\t\"supplierLabel\": false,\n\t\t\t\"lotNumber\": $state.context.receiptData.lotNumber,\n\t\t\t\"note\": $state.context.receiptData.note,\n\t\t\t\"quantity\": { \"value\": $scrapQuantity, \"unitId\": $unitId },\n\t\t\t\"quantityPerLicensePlate\": { \"value\": $scrapQuantity, \"unitId\": $unitId },\n\t\t\t\"receiptId\": $receiptId,\n\t\t\t\"statusId\": \"Pending\",\n\t\t\t\"workOrderProcessDistributionGroupId\": $groupId\n\t\t}}:[])\n};\n{\n\"receiptPayload\":$formatPayloads.receipt,\n\"receiptLinePayload\":$append($formatPayloads.unitsReceived, $formatPayloads.scrap)\n}\n \n)",
            "nextNodes": [
              "637a9d54-b543-4003-bb2a-6a60c4543238"
            ]
          },
