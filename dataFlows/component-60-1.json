        {
          "id": "57ac0b73-6391-4bfb-94e4-5847dbbcbb50",
          "name": "Query: INV",
          "type": "query",
          "data": {
            "api": "application",
            "variablesTransform": "{\n  \"where\": {\n    \"id\": {\n      \"_in\": [REQUEST.DATA.id]\n    }\n  }\n}",
            "query": "query Query($where: InventoryWhereInput, $orderBy: [InventoryOrderByInput!], $first: Int, $after: String) {\n  inventory(where: $where, orderBy: $orderBy, first: $first, after: $after) {\n    edges {\n      node {\n        id\n        number\n        active\n        quantity {\n          value\n          unitId\n        }\n        inventoryStatusId\n        locationId\n        lotId\n        masterInventoryId\n        productId\n        productStrategyProcessId\n        workOrderId\n        workOrderProcessId\n      }\n    }\n  }\n}\n",
            "nextNodes": [
              "f4fb2ae1-eaac-42a2-b26a-c94d88542948"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
          "logging": {
            "executionMetrics": false,
            "executionStarted": false,
            "executionSucceeded": false,
            "executionFailed": true,
            "enableTraceLogging": false
          }
        },
        {
          "id": "f4fb2ae1-eaac-42a2-b26a-c94d88542948",
          "name": "Mutate: INV TRX",
          "type": "mutate",
          "data": {
            "api": "Application",
            "variablesTransform": "(\n  $F :=  $components.Form1.data; \n  $inv := inventory.edges.node;\n\n  {\n    \"payload\": $inv.(\n      $id := id;\n      {\n        \"create\": $inv.{\n          \"sourceQuantity\": quantity,\n          \"customData\": $state.claims,\n          \"destinationQuantity\": {\n            \"value\":$F.quantity.value,\n            \"unitId\": quantity.unitId\n          },\n          \"sourceInventoryId\":id,\n          \"destinationInventoryId\":id,\n          \"sourceLocationId\": locationId,\n          \"destinationLocationId\": $F.location.id,\n          \"sourceInventoryStatusId\": inventoryStatusId,\n          \"destinationInventoryStatusId\": $F.inventoryStatus.id,\n          \"sourceLotId\": lotId,\n          \"destinationLotId\": $F.lot.id,\n          \"sourceProductId\":productId,\n          \"destinationProductId\":$F.product.id,\n          \"sourceProductStrategyProcessId\":productStrategyProcessId,\n          \"destinationProductStrategyProcessId\":$F.productStrategyProcess.id,\n          \"sourceWorkOrderProcessId\": workOrderProcessId,\n          \"destinationWorkOrderProcessId\": $F.workOrderProcess.id,\n          \"sourceMasterInventoryId\":masterInventory.id,\n           \"destinationMasterInventoryId\":$F.masterInventory.id, \n          \"statusId\":\"Review\",\n          \"adjustmentCodeId\": \"Manual\",\n          \"transactionTypeId\": \"InventoryAdminAdjustment\"\n        }\n      }\n    )\n  }\n\n)",
            "mutation": "mutation Mutation($payload: [InventoryTransactionCreatePayloadInput!]!) {\n  createInventoryTransaction(payload: $payload) {\n    id\n  }\n}\n",
            "nextNodes": [
              "5160a381-7737-47c4-abec-a745a48cac56"
            ]
          },
