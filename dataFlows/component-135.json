        {
          "id": "9a783750-657d-4d36-a778-bced534ef021",
          "name": "JSONata - Combine Data",
          "type": "transform",
          "data": {
            "transform": "(\n  $availabilityStart := $isNilOrEmpty($state.context.REQUEST.availabilityStart) ? $moment().startOf('day') :  $moment($state.context.REQUEST.availabilityStart);\n  $availabilityEnd := $isNilOrEmpty($state.context.REQUEST.availabilityEnd) ? $moment($availabilityStart).add(2, 'days').endOf('day') :  $moment($state.context.REQUEST.availabilityEnd);\n\n  $.workcenter.edges.node.(\n    $shiftCalendar := $getCalendar({\"id\":$.shiftGroup.calendarId});\n    \n    /* Does the request require a splitting of availbilty on shifts? */\n    $shiftCalendar := ($state.context.REQUEST.splitShifts=true) \n      ? $shiftCalendar ~> | calendar.calendarEvents.eventJson | {\"duration\": duration-1000, \"end\": $moment(end).subtract(1, 'second')} |\n      : $shiftCalendar;\n        \n    $workcenterCalendar := $getCalendar({\"id\":$.calendarId});\n    $maximumPositions := maximumPositions;\n    \n    /* Grab the events, ensure they do not exceed the max positions */\n    $events := $workcenterCalendar.calendar.calendarEvents.(\n      $merge([\n        $,\n        {\n          \"priority\": (priority > $maximumPositions or priority < 1) ? \"default\" : priority\n        }\n      ])\n    );\n    \n    /* group the events */\n    $events := $groupBy($events, function ($v) { $v.priority });\n    \n    /* pull out the default events */\n    $defaultEvents := $events.default;\n    \n    /* Apply them to ever position */\n    $positionEvents := $values($omit($events,\"default\")).[$, $defaultEvents];\n\n    /* rebuild each position as a full calendar for consideration */\n    $positionCalendars := $positionEvents.(\n      $merge([\n        $workcenterCalendar,\n        {\n          \"calendar\": {\n            \"calendarEvents\": $\n          }\n        }\n      ])\n    );\n\n    {\n      \"availabilityStart\": $availabilityStart,\n      \"availabilityEnd\": $availabilityEnd,\n      \"workcenter\": $omit($,[\"shiftGroup\",\"calendarId\"]),\n\n      /* loop each position calendar */\n      \"positions\": $positionCalendars.(\n        \n        /* combine each calendar with the shift's calendar */\n        $combinedCalendar := $mergeDeep([\n          $shiftCalendar,\n          $\n        ]);\n\n        $combinedAvailability := $getAvailabilityBetween($availabilityStart, $availabilityEnd, $combinedCalendar);\n\n        {\n          \"positionId\": $first($.calendar.calendarEvents.priority),\n          \"availability\": $combinedAvailability[groupEventType=\"available\"]\n        }\n      ),        \n      \"calendars\": {\n        \"shift\": $shiftCalendar.calendar,\n        \"workcenter\": $workcenterCalendar.calendar\n      }\n    };\n  )  \n)",
            "nextNodes": [
              "118c8486-4aaf-469a-90de-4d08ddabc106"
            ]
