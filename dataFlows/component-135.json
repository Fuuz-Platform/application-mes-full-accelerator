        {
          "id": "23ba665d-422e-4a40-9862-9253134a70bb",
          "name": "Query Workcenter Data",
          "type": "query",
          "data": {
            "api": "application",
            "variablesTransform": "{\n  \"where\": {\n    \"id\": {\n      \"_in\": $state.context.REQUEST.workcenters\n    }\n  }\n}",
            "query": "query workcenters($where:WorkcenterWhereInput!){\n  workcenter(where:$where) {\n    edges {\n      node {\n        id\n        name\n        code\n        maximumConcurrency\n        maximumPositions\n        productionOffalAllowed\n        setupOffalAllowed\n        active\n        productionOperators\n        setupOperators\n        shiftGroup {\n          calendarId\n        }\n        calendarId\n      }\n    }\n  } \n}",
            "nextNodes": [
