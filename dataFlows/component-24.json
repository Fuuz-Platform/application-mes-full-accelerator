          "id": "6ffa8de5-02b0-4da7-8a55-f3ff779a3aa9",
          "name": "Mutate - Create Inventory Record(s)",
          "type": "mutate",
          "data": {
            "api": "Application",
            "variablesTransform": "{\n  \"payload\": [[1..$.addMultipleQuantity].{\n    \"create\": {\n      \"number\": $$.number,\n      \"active\": true,\n      \"productId\": $$.product.id,\n      \"productStrategyProcessId\": $$.productStrategyProcess.id,\n      \"quantity\": {\n        \"value\": $$.quantity.value,\n        \"unitId\": $$.quantity.unit.id\n      },\n      \"inventoryStatusId\": $$.inventoryStatus.id,\n      \"locationId\": $$.location.id,\n      \"note\": $$.note.text,\n      \"lotId\": $$.lot.id,\n      \"barcode\":$$.barcode\n    }\n  }]\n}",
            "mutation": "mutation createInventory($payload:[InventoryCreatePayloadInput!]!){\n  createInventory(payload:$payload) {\n    id  \n  }\n}",
            "nextNodes": [
              "c8e47811-f6d0-4b55-884d-04ea0ed4cb60"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
          "logging": {
            "executionMetrics": false,
            "executionStarted": false,
            "executionSucceeded": false,
            "executionFailed": true,
            "enableTraceLogging": false
          }
        },
        {
          "id": "c8e47811-f6d0-4b55-884d-04ea0ed4cb60",
          "name": "Mutate - Create Inventory Transaction(s)",
          "type": "mutate",
          "data": {
            "api": "Application",
            "mutation": "mutation createInventoryTransaction($payload:[InventoryTransactionCreatePayloadInput!]!){\n  createInventoryTransaction(payload:$payload) {\n    id\n  }\n}",
            "nextNodes": [
              "08f42670-1e43-4612-8986-f4f3f1b8be3d"
            ],
            "variablesTransform": "{\n  \"payload\": [$.createInventory.id.{\n    \"create\": {\n      \"transactionTypeId\": \"Inventory Adjustment\",\n      \"adjustmentCodeId\": $state.context.REQUEST.adjustmentCode.id,\n      \"customData\": $state.claims,\n      \"sourceQuantity\": {\n        \"value\": 0,\n        \"unitId\": $state.context.REQUEST.quantity.unit.id\n      },\n      \"sourceLocationId\": $state.context.REQUEST.location.id,\n      \"sourceInventoryId\": $,\n      \"sourceInventoryStatusId\": $state.context.REQUEST.inventoryStatus.id,\n      \"sourceProductStrategyProcessId\": $state.context.REQUEST.productStrategyProcess.id,\n      \"sourceLotId\": $state.context.REQUEST.lot.id,\n      \"sourceProductId\": $state.context.REQUEST.product.id,\n      \"destinationQuantity\": {\n        \"value\": $state.context.REQUEST.quantity.value,\n        \"unitId\": $state.context.REQUEST.quantity.unit.id\n      },\n      \"destinationLocationId\":  $state.context.REQUEST.location.id,\n      \"destinationInventoryId\": $,\n      \"destinationInventoryStatusId\": $state.context.REQUEST.inventoryStatus.id,\n      \"destinationProductStrategyProcessId\": $state.context.REQUEST.productStrategyProcess.id,\n      \"destinationLotId\": $state.context.REQUEST.lot.id,\n      \"destinationProductId\": $state.context.REQUEST.product.id\n    }\n  }]\n}"
          },
