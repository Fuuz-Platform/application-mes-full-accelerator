            "variablesTransform": "$",
            "nextNodes": [
              "d06e7c9d-233a-4440-9118-665c4e9223e5"
            ],
            "query": "query Query($sourceInventoryId: [String!]!, $destinationInventoryId: [String!]!) {\n  sourceInventory: inventory(where: {id: {_in: $sourceInventoryId}}){\n    edges {\n      node {\n        id\n        destinationTransactions(where: {_not: {sourceInventoryId:{_in: $sourceInventoryId}}}){\n          edges{\n            node{\n              sourceInventoryId\n              sourceQuantity{\n                value\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n  destinationInventory: inventory(where: {id: {_in: $destinationInventoryId}}){\n    edges {\n      node {\n        id\n\t\t\t\tsourceTransactions(where: {_not: {destinationInventoryId:{_in: $destinationInventoryId}}}){\n          edges{\n            node{\n              destinationInventoryId\n              destinationQuantity{\n                value\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}"
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
          "logging": {
            "executionMetrics": false,
            "executionStarted": false,
            "executionSucceeded": false,
            "executionFailed": true,
            "enableTraceLogging": false
          }
        },
        {
          "id": "d06e7c9d-233a-4440-9118-665c4e9223e5",
          "name": "Merge Context",
          "type": "mergeContext",
          "data": {
            "transform": "(\n  $inventoryRelationships := \n      [\n        sourceInventory.edges.node.destinationTransactions.edges.node.{\n          \"from\": sourceInventoryId,\n          \"to\": %.%.%.id,\n          \"value\": sourceQuantity.value\n        },\n        destinationInventory.edges.node.sourceTransactions.edges.node.{\n          \"from\":  %.%.%.id,\n          \"to\": destinationInventoryId,\n          \"value\": destinationQuantity.value\n        }\n      ];\n  {\n    \"LOCAL\": $inventoryRelationships\n  }\n)",
            "nextNodes": [
              "76e6dae4-d8a8-43d5-b921-e2af06922459"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
