      "type": "System",
      "nodes": [
        {
          "id": "a3c57a14-54da-4c34-8254-89266111d7b0",
          "name": "Get History without end dates",
          "type": "query",
          "data": {
            "api": "application",
            "variablesTransform": "{}",
            "query": "{\n  workcenterHistory(\n    where:{\n      endAt:{_isNull: true}\n    }\n  ) {\n    edges {\n      node {\n        id\n        workcenterId\n        occurAt\n      }\n    }\n  }\n}",
            "nextNodes": [
              "4c85b26b-e965-47ac-bf12-4a7125057f70"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
