        {
          "id": "2d151b32-b6b4-49ba-8d2f-c2b6c6af8dcf",
          "name": "Convert to Gantt",
          "type": "transform",
          "data": {
            "nextNodes": [
              "7b67595e-157f-40d2-a260-ce0e33a8c435"
            ],
            "transform": "(\n  $available := \"#62B58D\";\n  $unallocated := \"#E7E7E7\";\n  $unavailable := \"#d84343\";\n                \n  {  \n     \"chart\": {\n          \"dateFormat\": \"mm/dd/yyyy hh:mm:ss\",\n          \"caption\": \"Workcenter Utilization Overview\",\n          \"legendCaption\": \"Included Statuses\",\n          \"showTaskLabels\": false,\n          \"showTaskEndDate\": false,\n          \"animation\": false,\n          \"exportEnabled\": true,\n          \"ganttPaneDuration\": 1,\n          \"ganttPaneDurationUnit\": 'm',\n          \"toolBarPosition\": \"TR\",\n          \"toolBarButtonColor\": \"#FFC533\",\n          \"showLegend\": 1,\n          \"legendShadow\": 0\n              },\n    \"legend\": {\n      \"item\": [\n        {\n          \"label\": \"available\",\n          \"color\": $available\n        },\n        {\n          \"label\": \"unavailable\",\n          \"color\": $unavailable\n        },\n        {\n          \"label\": \"unallocated\",\n          \"color\": $unallocated\n        }        \n      ]\n    },\n    \"tasks\": {\n      \"task\": [\n        $.(\n          $name := name;\n          $workcenterGroup := workcenterGroup;\n          $calendarId := calendarId;\n          \n          \n          $values(events).*.($).(\n            $label := ($.eventsBetween.title) ? \n              $join([$.eventsBetween.title],\", \")\n              : $uppercase($substring(groupEventType,0,1)) & $substring(groupEventType,1);\n\n            /* (groupEventType=\"unavailable\") ? $unavailable : $available*/\n            \n            $currentColor := (groupEventType=\"unallocated\") ? $unallocated : \n              ($coalesce([$count(eventsBetween[calendarEventTypeId='unavailable']),0])>0) ? $unavailable\n                : $available;\n                \n            {\n              \"label\": $label,\n              \"processid\": $name,\n              \"start\": $moment(start).format(\"MM/DD/YYYY HH:MM:ss\"),\n              \"end\": $moment(end).format(\"MM/DD/YYYY HH:MM:ss\"),\n              \"bordercolor\": $currentColor,\n              \"color\": $currentColor,\n              \"toppadding\": \"12%\",\n              \"height\": \"32%\",\n              \"link\": \"https://demo.fuuz.app/system/configuration/calendars/\" & $calendarId & \"?component=CalendarEventViewForm\"\n            }\n          )\n        )\n      ]\n    },\n    \"processes\": {\n      \"isbold\": \"1\",\n      \"headertext\": \"Workcenters\",\n      \"process\": [\n        $.{\n          \"label\": name & \"<BR>\" & availablePct & \"%\",\n          \"id\": name,\n          \"link\": \"https://demo.fuuz.app/system/configuration/calendars/\" & calendarId & \"?component=CalendarEventViewForm\"\n        }\n      ]\n    },\n    \"categories\": [\n      {\n        \"category\": [\n          $keys($.**.events).{\n            \"start\": $ & \" 00:00:00\",\n            \"end\": $ & \" 23:59:59\",\n            \"name\": $\n          }\n        ]\n      }\n    ]\n  }\n)"
          },
