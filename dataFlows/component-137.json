      "nodes": [
        {
          "id": "d91e9b91-54ad-49e7-8b7a-d56c223842bb",
          "name": "Query - Workcenter(s) with Calendars",
          "type": "query",
          "data": {
            "api": "application",
            "variablesTransform": "{\n  \"where\": {\n  \t\"calendarId\": {\n      \"_isNull\": false\n    },\n    \"workcenterGroupId\": (workcenterGroupId) ? {\n      \"_eq\": workcenterGroupId\n    },\n    \"workcenterTypeId\": (workcenterTypeId) ? {\n      \"_eq\": workcenterTypeId\n    }\n  }\n}",
            "query": "query workcenter($where:WorkcenterWhereInput!){\n  workcenter(where:$where) {\n    edges {\n      node {\n        id\n        name\n        workcenterGroup {\n          id\n          name\n        }\n        calendarId\n      }\n    }\n  } \n}",
            "nextNodes": [
              "ee5e6780-84e9-40fb-bd9e-054b91cc7248"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
          "logging": {
            "executionMetrics": false,
            "executionStarted": false,
            "executionSucceeded": false,
            "executionFailed": true,
            "enableTraceLogging": false
          }
        },
        {
          "id": "ee5e6780-84e9-40fb-bd9e-054b91cc7248",
          "name": "Process Calendar Data",
          "type": "transform",
          "data": {
            "transform": "(\n  $diff := function($start,$end) {\n    $moment($end).diff($moment($start))\n  };\n  \n  $uniq($.**.node).\n  (\n    /* Get the calendar objects */\n    $currentCalendar := $getCalendar({\"id\": calendarId, \"name\": \"\"}); \n    \n    ($currentCalendar) ? (\n      $eventList := $getAvailabilityBetween(\n        $moment().add(0,'days').startOf('day'), \n        $moment().add($coalesce([$state.context.daysOut,5]),'days').endOf('day'), \n        $currentCalendar\n      ).(\n          $between := $eventsBetween(start,end,$currentCalendar);\n          \n          $obj := $merge([$,{\n            \"startAt\": $moment(start).format(\"MM/DD/YYYY\"),\n            \"endAt\": $moment(end).format(\"MM/DD/YYYY\"),\n            \"total\": $diff(start, end)/1000/60,\n\n            \"eventsBetween\": ($count($between)=0) ? $between : $getEventsAt(start,$currentCalendar)[-1]\n            \n          }]).(\n            /* Pass back through and look at the events between to determine actual availability */\n            $currentType := (groupEventType=\"unallocated\") ? \"unallocated\" : \n              ($coalesce([$count(eventsBetween[calendarEventTypeId='unavailable']),0])>0) ? \"unavailable\"\n                : \"available\";         \n          \n            $merge([$,{\n              \"available\": ($currentType=\"available\") ? $diff(start, end)/1000/60 : 0,\n              \"unAvailable\": ($currentType=\"unavailable\") ? $diff(start, end)/1000/60 : 0,\n              \"unAllocated\": ($currentType=\"unallocated\") ? $diff(start, end)/1000/60 : 0\n            }])\n          );\n          \n          /* Unallocation happens for that time between 23:59:59.999Z and 00:00:00.000Z so we need to omit them */\n          ($obj.total > 0.0001) ? $obj\n        );\n      \n      ($eventList) ? (\n        $eventList := $groupBy($eventList, function ($v) { $v.endAt });\n\n        $merge([$,{\n          \"events\": $eventList,\n          \"total\": $sum($eventList.**.total),\n          \"available\": $sum($eventList.**.available),\n          \"unAvailable\": $sum($eventList.**.unAvailable),\n          \"unAllocated\": $sum($eventList.**.unAllocated)\n        }]).(\n          $merge([$,{\n            \"availablePct\": $round(available/total * 100, 2),\n            \"unAvailablePct\": $round(unAvailable/total * 100, 2),\n            \"unAllocatedPct\": $round(unAllocated/total * 100,2)\n          }]);\n        );\n      )\n    )\n  );\n)",
            "nextNodes": [
              "2d151b32-b6b4-49ba-8d2f-c2b6c6af8dcf"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
          "logging": {
            "executionMetrics": false,
            "executionStarted": false,
            "executionSucceeded": false,
            "executionFailed": true,
            "enableTraceLogging": false
          }
        },
