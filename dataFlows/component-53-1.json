            ],
            "query": "query Query($where: InventoryWhereInput, $orderBy: [InventoryOrderByInput!], $first: Int, $after: String) {\n  inventory(where: $where, orderBy: $orderBy, first: $first, after: $after) {\n    edges {\n      node {\n        id\n        grossWeight\n        number\n        theoreticalWeight\n        active\n        barcode\n        note\n        trackingNumber\n        customData\n        workOrderProcess{\n          process{\n            code\n          }\n        }\n        workOrder{\n          number\n          product{\n            id\n            code\n            name\n          }\n        }\n  \n    productStrategyProcess{\n    productStrategy{\n    product{\n    id\n    name\n    code\n    customData\n    upc\n  }\n  }\n    \n  }\n        quantity {\n          value\n          unitId\n        }\n        inventoryStatusId\n        inventoryTypeId\n        locationId\n        kanbanCardId\n        lotId\n        masterInventoryId\n        packagingMaterialId\n        productStrategyProcessId\n        receiptLineId\n        receiptLine {\n          id\n          licensePlates\n          supplierLabel\n          code\n          lotNumber\n          note\n          purchaseOrderLineId\n          purchaseOrderLine {\n            id\n            externalReceiptQuantity\n            price\n            masterPriceUse\n            description\n            externalId\n            lotNumber\n            number\n            dueAt\n            purchaseOrderId\n            purchaseOrder {\n              id\n              number\n              externalId\n              note\n              shipmentNumber\n              issuedAt\n              purchaseOrderTypeId\n              supplierId\n              purchaseOrderStatusId\n            }\n            purchaseOrderLineStatusId\n            productId\n            product {\n              id\n              code\n              active\n              externalId\n              name\n              number\n              revision\n              customData\n              imageId\n              productStageId\n              productTypeId\n            }\n            productStrategyProcessId\n          }\n          receiptId\n          receiptStatusId\n          inventoryStatusId\n          lotId\n        }\n        supplierId\n        weightUnitId\n        workOrderId\n        workOrderProcessId\n        createdAt\n      }\n    }\n  }\n}\n"
          },
