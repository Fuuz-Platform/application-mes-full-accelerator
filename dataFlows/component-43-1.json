          "name": "Query Inventory",
          "type": "query",
          "data": {
            "api": "application",
            "variablesTransform": "{\n  \"where\": {\n    \"id\": {\n      \"_in\": [$.id]     \n    }\n  },\n  \"orderBy\": {\n    \"field\": \"number\",\n    \"direction\": \"asc\"\n  }\n}",
            "nextNodes": [
              "270ab2f1-563c-4fe7-8f80-054ec20fc52e"
            ],
            "query": "query Query($where: InventoryWhereInput, $orderBy: [InventoryOrderByInput!], $first: Int, $after: String) {\n  inventory(where: $where, orderBy: $orderBy, first: $first, after: $after) {\n    edges {\n      node {\n        id\n   \n        number\n       \n        barcode\n    \n      \n  \n    product {code}\n    productStrategyProcess{\n    productStrategy{\n    product{\n    id\n    name\n    code\n\n  }\n  }\n    \n  }\n        quantity {\n          value\n          unitId\n        }\n     \n        locationId\n       \n        lotId\n     \n        productStrategyProcessId\n        receiptLineId\n        receiptLine {\n          id\n      \n     \n          purchaseOrderLineId\n          purchaseOrderLine {\n            id\n        \n            number\n         \n            purchaseOrderId\n            purchaseOrder {\n              id\n              number\n              externalId\n              note\n              shipmentNumber\n              issuedAt\n              purchaseOrderTypeId\n              supplier {code}\n              purchaseOrderStatusId\n            }\n            purchaseOrderLineStatusId\n            productId\n            product {\n              id\n              code\n              active\n              externalId\n              name\n              number\n\n              customData\n             \n              productStageId\n              productTypeId\n            }\n            productStrategyProcessId\n          }\n          receiptId\n      \n          lotId\n        }\n        supplierId\n        weightUnitId\n        workOrderId\n        workOrderProcessId\n        createdAt\n      }\n    }\n  }\n}\n"
          },
          "debug": {
