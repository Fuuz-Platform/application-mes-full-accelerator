      "nodes": [
        {
          "id": "1ac49747-99e9-43f3-abc6-6730db6f7b02",
          "name": "Query: SETUP",
          "type": "query",
          "data": {
            "api": "application",
            "variablesTransform": "{\n  \"where\": {\n    \"id\": {\n      \"_in\":[workcenterId]\n    }\n  }\n}",
            "query": "query Query($where: ProductionSetupWhereInput!) {\n  setup: productionSetup(where: $where) {\n    edges {\n      node {\n        id\n        outputs {\n          edges {\n            node {\n              id\n              productStrategyProcess {\n                productStrategyProcessAssets {\n                  edges {\n                    node {\n                      assetDesign {\n                        id\n                        name\n                      }\n                      assetGroupDesign {\n                        name\n                        id\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n        productionAssets {\n          edges {\n            node {\n              asset {\n                id\n                number\n                assetDesignId\n              }\n              assetGroup {\n                number\n                assetGroupDesignId\n                id\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n",
            "nextNodes": [
              "4bfdb531-ac58-4bed-9a1b-64c7570980f0"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
          "logging": {
            "executionMetrics": true,
            "executionStarted": false,
            "executionSucceeded": false,
            "executionFailed": true,
            "enableTraceLogging": false
          }
        },
        {
          "id": "4bfdb531-ac58-4bed-9a1b-64c7570980f0",
          "name": "Calculate tool validation",
          "type": "transform",
          "data": {
            "transform": "(\n  $productStrategyProcessAssets := $.setup.edges.node.outputs.edges.node.productStrategyProcess.productStrategyProcessAssets;\n  $requiredDesigns := $groupBy(\n    [\n      $productStrategyProcessAssets.edges.node.assetDesign,\n      $productStrategyProcessAssets.edges.node.assetGroupDesign\n    ],\n    $lookup(?, \"id\")\n  );\n\n  $loadedAssets := $groupBy(\n    [\n      setup.edges.node.productionAssets.**.asset, \n      setup.edges.node.productionAssets.**.assetGroup\n    ],\n    function($v){ $coalesce([$v.assetDesignId, $v.assetGroupDesignId])}\n  );\n  \n  $mapValues(\n    $requiredDesigns, \n    function($v, $k){\n      {\n        \"name\": $v.name,\n        \"id\": $v.id,\n        \"valid\": $count($v) <= $count($lookup($loadedAssets, $k))\n      }\n    }\n  );\n  \n)",
            "nextNodes": [
              "62be93fa-3e15-4e55-946d-338ac7d11183"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
          "logging": {
            "executionMetrics": false,
            "executionStarted": false,
            "executionSucceeded": false,
            "executionFailed": true,
            "enableTraceLogging": false
          }
        },
        {
          "id": "62be93fa-3e15-4e55-946d-338ac7d11183",
          "name": "Is tooling valid",
          "type": "ifElse",
          "data": {
            "transform": "$not(false in $.*.valid)",
            "onTrueNextNodes": [
              "97522f08-2946-4ac5-a9b5-bd589c997ae2"
            ],
            "onFalseNextNodes": [
