            "variablesTransform": "{\n  \"payload\": {\n    \"create\": {\n      \"id\": $state.context.value.after.id,\n      \"name\": $state.context.value.after.name,\n      \"description\": \"Auto created for time management.\"\n    },\n    \"update\": {\n      \"name\": $state.context.value.after.name,\n      \"description\": \"Auto created for time management.\"\n    },\n    \"where\": {\n    \"id\": $state.context.value.after.id\n    }\n  },\"payloadR\": {\n    \"create\": {\n      \"id\": $state.context.value.after.id,\n      \"title\": $state.context.value.after.name,\n      \"description\": $state.context.value.after.name\n    },\n    \"update\": {\n      \"title\": $state.context.value.after.name,\n      \"description\": $state.context.value.after.name\n    },\"where\":{\n    \"id\":$state.context.value.after.id\n    }\n  }\n}",
            "mutation": "mutation createCalendar($payload:[CalendarUpsertPayloadInput!]!,$payloadR:[CalendarResourceUpsertPayloadInput!]!){\n  upsertCalendar(payload:$payload) {\n    id\n  }\n  upsertCalendarResource(payload:$payloadR){id}\n}",
