        {
          "id": "2f2ebaed-316e-402d-a7ec-e16b2f2a9c1f",
          "name": "Query Shipment",
          "type": "query",
          "data": {
            "api": "application",
            "variablesTransform": "{\n  \"where\": {\n    \"id\": {\n      \"_eq\": $state.context.REQUEST.shipmentId\n    },\n    \"shipmentStage\": {\n       \"_and\":[{\n          \"active\": {\n            \"_eq\": true\n          }},{\n            \"cancelled\": {\n              \"_eq\": false\n              \n            }   \n        },{\n          \"complete\":{\n            \"_eq\": false \n          }\n        }\n      ]\n    }\n  }\n}",
            "query": "query Query($where: ShipmentWhereInput, $orderBy: [ShipmentOrderByInput!], $first: Int, $after: String) {\n  shipment(where: $where, orderBy: $orderBy, first: $first, after: $after) {\n    edges {\n      node {\n        id\n        number\n        stopNumber\n        externalId\n        freightTerms\n        note\n        proNumber\n        trackingNumber\n        trailerNumber\n        scheduledArrivalAt\n        scheduledShipAt\n        customData\n        shipmentStageId\n        shipmentTypeId\n        carrierSupplierId\n        loadId\n        purchaseOrderId\n        salesOrderId\n        shipFromFacilityId\n        shipToCustomerAddressId\n        shipToFacilityId\n        shipToSupplierAddressId\n        transferOrderId\n        shipmentLines {\n          edges {\n            node {\n              id shipQuantity {value unitId}\n            }\n          }\n        }\n      }\n    }\n  }\n}\n",
            "nextNodes": [
              "19a22d8b-25a0-42ca-9674-4b5026e88ca5"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
