          "name": "Create FulfillmentLines",
          "type": "mutate",
          "data": {
            "api": "Application",
            "variablesTransform": "{\n  \"payload\": $state.context.LOCAL.shipment.shipmentLines.edges.node.{\n    \"create\": {\n      \"lineQuantity\": shipQuantity.value,\n      \"shipperFulfillmentId\": $state.context.LOCAL.shipperFulfillmentId,\n      \"shipmentLineId\": id\n    }\n  }\n}",
            "mutation": "mutation CFL($payload:[ShipperLineFulfillmentCreatePayloadInput!]!){\n  createShipperLineFulfillment(payload:$payload) {\n    id\n  }\n}",
