        {
          "id": "ebb093c6-c356-4490-970f-0cb5e3e2b03b",
          "name": "Create Fulfillment",
          "type": "mutate",
          "data": {
            "api": "Application",
            "variablesTransform": "{\n  \"payload\": {\n    \"create\": {\n      \"quantity\":$sum([$state.context.shipment.shipmentLines.edges.node.shipQuantity.value]),\n      \"shipmentId\": $state.context.REQUEST.shipmentId\n    }\n  }\n}",
            "mutation": "mutation CS($payload: [ShipperFulfillmentCreatePayloadInput!]!){\n  createShipperFulfillment(payload:$payload) {\n    id\n}\n}",
            "nextNodes": [
