{
  "header": {
    "id": "qualityCheckWidget",
    "name": "Quality Check Widget",
    "description": "script to run when editing the dynamic column of Quality Report Widget (based on the Evaluate Quality Checks saved transform)",
    "active": true,
    "deprecated": false
  },
  "version": {
    "id": "cm5lk59o3000h3j6jfp8rhfbk",
    "number": "0.0.9",
    "description": null,
    "savedTransformId": "qualityCheckWidget",
    "scriptLanguageId": "JSONata",
    "transform": "(\n    $$.check.typeId = \"Number\" ? (\n      $numberValue := $$.value ~> $number;\n      $not($isNilOrEmpty($$.check.lowerBound)) and $not($isNilOrEmpty($$.check.upperBound)) ?\n        ($$.check.lowerBound ~> $number) <= $numberValue and $numberValue <= ($$.check.upperBound ~> $number)\n      :\n      $not($isNilOrEmpty($$.check.lowerBound)) ?\n        ($$.check.lowerBound ~> $number) <= $numberValue\n      :\n      $not($isNilOrEmpty($$.check.upperBound)) ?\n        $numberValue <= ($$.check.upperBound ~> $number)\n      :\n      $numberValue = ($$.check.expectedValue ~> $number)\n    ) : \n    $$.check.typeId = \"Boolean\" ? (\n      $$.value = $$.check.expectedValue\n    ) : \n    $$.check.typeId = \"String\" ? (\n      $$.value= $$.check.expectedValue\n    ) : \n    $$.check.typeId = \"Regex\" ? (\n      $contains($$.value, $eval($$.check.expectedValue))\n    ) \n)",
    "inputSchema": {
      "type": "object",
      "properties": {
        "check": {
          "type": "object"
        },
        "value": {}
      },
      "required": []
    },
    "outputSchema": {}
  }
}