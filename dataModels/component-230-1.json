        {
          "name": "productionDuration",
          "type": "Float!",
          "description": "Run duration for this group - this is the duration to be used for scheduling purposes - this run duration should NOT include any setup time, purely production time - based upon the standardRate from the work order processes within the group.\n\nrunDuration - also considers if sequentialOutput is true - when true, the run duration is the sum of all the outputs.\n\nDefault = 0",
          "metadata": {
            "mfgx": {
              "mutations": {
                "create": {
                  "include": true
                },
                "update": {
                  "include": true
                }
              },
              "queries": {
                "include": true
              },
              "where": {
                "include": true
              },
              "defaultValue": 0
            },
            "unique": false
          }
        },
        {
          "name": "setupDuration",
          "type": "Float!",
          "description": "The actual setup time used for this group - This may not be = the aggSetupRate - if 'single setup rate' is being used, if single setup rate is used, than the longest SetupRate from all of the workOrderProcesses within the Group should be used (max.). This value should ONLY represent the \"initial\" setup time required for this group - any minor setup time (between work order processes should not be counted here).\n\nThis setup time, can be manually adjusted by the user - prior to scheduling the Group - but after scheduling is completed this must be read Only.\n\nDefault = 0",
          "metadata": {
            "mfgx": {
              "mutations": {
                "create": {
                  "include": true
                },
                "update": {
                  "include": true
                }
              },
