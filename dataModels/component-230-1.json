        {
          "name": "latestEndAt",
          "type": "DateTime!",
          "description": "LatestEndAt is the latest date from the collection of Work Order Processes within the Group. This represents the absolute due date for this entire group - to be considered by scheduling.\n\nField maybe edited by the user, this would impact the scheduling. This field makes no impact after scheduling has been completed.\n\nREQUIRED (no default in API)",
          "metadata": {
            "mfgx": {
